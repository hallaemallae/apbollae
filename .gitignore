node_modules/
dist/

# 인증키 — 절대 커밋 금지
.env
.env.*
!.env.example
.secret.local

# Functions 비밀 아닌 설정은 커밋한다
!sorc/server/functions/.env.apbollae

# 로컬 프록시 ITS 사용량 기록
sorc/server/.its-usage.json

# UTIC CCTV 목록 저장본(학교 망에서 받음, 원본에 접속 정보가 들어 있을 수 있다)
sorc/server/.utic-*

# 표준노드링크 원본(수백 MB) — 각자 ITS 에서 받는다
sorc/data/nodelink/

# 카카오 JS 키(도메인 제한 공개용)만 올린다. REST 키·ITS 키는 sorc/server/.env (커밋 안 함)
!sorc/web/.env.development

# 산출물 옛 버전은 로컬에만 둔다(docs 에는 최신본만 올림)
docs/이전버전/
.vscode/
etc/녹음*.mp4
~$*
