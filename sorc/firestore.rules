rules_version = '2';

// 앞볼래 Firestore 보안 규칙
// users/{uid} — 본인만 읽고 쓴다. 위치정보는 어떤 컬렉션에도 저장하지 않는다(위치기반서비스 약관 기준).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['email', 'provider', 'consents', 'welcomeSeen', 'createdAt', 'updatedAt'])
        // 가입 시각은 처음 정한 값에서 바꿀 수 없다
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
    }

    // 그 밖의 경로는 모두 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
