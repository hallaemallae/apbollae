{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "server/functions",
      "codebase": "default",
      "ignore": ["node_modules", ".secret.local", "*.log"]
    }
  ],
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-northeast3" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "ui": { "enabled": false }
  }
}
